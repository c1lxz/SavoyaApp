ENVIRONMENT=production
APP_NAME=GateApp Backend
DEBUG=False
DOCS_ENABLED=False

# Generate a long random value and keep it only on the server.
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ISSUER=savoya-backend
JWT_AUDIENCE=savoya-clients

ALLOWED_HOSTS_JSON=["xn--80aaachc8cmu1au8c1f.xn--p1ai","www.xn--80aaachc8cmu1au8c1f.xn--p1ai","127.0.0.1","localhost","testserver"]
CORS_ALLOW_ORIGINS_JSON=["https://xn--80aaachc8cmu1au8c1f.xn--p1ai","https://www.xn--80aaachc8cmu1au8c1f.xn--p1ai","http://127.0.0.1","http://localhost"]

# Use either sqlite+aiosqlite:///./backend_prod.db or your own PostgreSQL DSN.
DATABASE_URL=sqlite+aiosqlite:///./backend_prod.db

BOOTSTRAP_DEMO_USER=False
DEMO_LOGIN=demo
DEMO_PASSWORD=CHANGE_THIS_IF_BOOTSTRAP_DEMO_USER_TRUE
DEMO_PHONE=+70000000000
DEMO_FULL_NAME=Demo User
DEMO_PLOT_NUMBER=25

BOOTSTRAP_ADMIN_USER=False
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_ADMIN_PASSWORD
ADMIN_PHONE=+79990009999
ADMIN_FULL_NAME=Administrator Savoya
ADMIN_PLOT_NUMBER=ADMIN
BOOTSTRAP_TEST_USERS_JSON=[]

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_IP_RATE_LIMIT_ATTEMPTS=20
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=300
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900

GATE_REAL_INTEGRATION_ENABLED=False
GATE_MDB_PATH=C:/GATE/Server/config.mdb
GATE_SYSTEMDB_PATH=C:/GATE/Server/Gate.mdw
GATE_MDB_UID=YOUR_GATE_UID
GATE_MDB_PWD=YOUR_GATE_PASSWORD
GATE_ODBC_DRIVER=Driver do Microsoft Access (*.mdb)
GATE_PYTHON_VERSION=-3.12-32
GATE_BRIDGE_TIMEOUT_SECONDS=30
GATE_REAL_KEYTYPE_VEHICLE=3
GATE_REAL_KEYTYPE_PHONE=6
GATE_PHONE_WRITE_FORMAT=sample
GATE_ACTION_MAP_JSON={"entry":19,"exit":20,"wicket_north":15,"wicket_lake":23,"wicket_admin":17,"wicket_forest":21}
DEFAULT_ACCESS_POINT_IDS_JSON=[15,17,19,20,21,23]
GSM_ACCESS_POINT_IDS_JSON=[]
GATE_OPEN_MODE=simulate
GATE_OPEN_SUCCESS_RATE=0.9

COURIER_TTL_ONLY_ENABLED=True
COURIER_DEFAULT_HOURS=2
COURIER_MAX_HOURS=12

GATE_WIEGAND_TRANSPORT=dry_run
GATE_GATETERM_EXE=C:/GATE/Terminal/GateTerm.exe
GATE_GATETERM_UI_VERIFY_TIMEOUT_SECONDS=15
GATE_WIEGAND_TIMEOUT_SECONDS=2.0
GATE_GATESERV_HOST=127.0.0.1
GATE_GATESERV_PORT=1917
GATE_GATESERV_PAYLOAD_FORMAT=gate_monitor_json
GATE_GATESERV_APPEND_NEWLINE=true
GATE_GATESERV_ENCODING=utf-8
GATE_WIEGAND_HTTP_URL=http://127.0.0.1:9000/wiegand
GATE_WIEGAND_HTTP_TOKEN=
GATE_WIEGAND_TCP_HOST=192.168.0.65
GATE_WIEGAND_TCP_PORT=5000
GATE_WIEGAND_TCP_PAYLOAD_FORMAT=json
GATE_WIEGAND_TCP_APPEND_NEWLINE=true
GATE_WIEGAND_TCP_ENCODING=utf-8

EXPO_PUBLIC_USE_REAL_API=true
EXPO_PUBLIC_API_BASE_URL=/api

# Docker Compose variables
POSTGRES_USER=savoya
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
POSTGRES_DB=gate_app
