# =========================
# SavoyaApp production .env
# =========================
# This file is intended for deployment on the same Windows server
# where Gate Server and the main config.mdb are installed.

# -------------------------
# Backend application
# -------------------------
APP_NAME=GateApp Backend
DEBUG=False
DOCS_ENABLED=False
SECRET_KEY=9xV7!savoya_JWT_2026#R4mL2@Qp8Zc1Dn5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Allow localhost, the server IP, and the purchased domain.
# Use punycode in Host/CORS values to avoid encoding issues.
ALLOWED_HOSTS_JSON=["xn--80aaachc8cmu1au8c1f.xn--p1ai","www.xn--80aaachc8cmu1au8c1f.xn--p1ai","185.245.187.125","127.0.0.1","localhost","testserver"]
# Older repo placeholder example:
# ALLOWED_HOSTS_JSON=["xn--80aaachc8cmu1au8c1f.xn--p1ai","203.0.113.10","127.0.0.1","localhost","testserver"]

# Frontend origins allowed by backend CORS.
# Keep both http and https until TLS is configured on the server.
CORS_ALLOW_ORIGINS_JSON=["http://xn--80aaachc8cmu1au8c1f.xn--p1ai","https://xn--80aaachc8cmu1au8c1f.xn--p1ai","http://www.xn--80aaachc8cmu1au8c1f.xn--p1ai","https://www.xn--80aaachc8cmu1au8c1f.xn--p1ai","http://185.245.187.125","https://185.245.187.125","http://127.0.0.1","http://localhost"]
# Older repo placeholder example:
# CORS_ALLOW_ORIGINS_JSON=["http://xn--80aaachc8cmu1au8c1f.xn--p1ai","https://xn--80aaachc8cmu1au8c1f.xn--p1ai","http://203.0.113.10","http://127.0.0.1","http://localhost"]

# -------------------------
# Backend database
# -------------------------
DATABASE_URL=sqlite+aiosqlite:///./backend_test_local.db

# -------------------------
# Demo/bootstrap user
# Disable in production.
# -------------------------
BOOTSTRAP_DEMO_USER=True
DEMO_LOGIN=demo
DEMO_PASSWORD=demo123
DEMO_PHONE=+70000000000
DEMO_FULL_NAME=Демо Пользователь
DEMO_PLOT_NUMBER=25
BOOTSTRAP_ADMIN_USER=True
ADMIN_LOGIN=savoya.root.2026
ADMIN_PASSWORD=SvY-Adm!n_7Qf9K2Lx#2026
ADMIN_PHONE=+79990009999
ADMIN_FULL_NAME=Администратор Savoya
ADMIN_PLOT_NUMBER=ADMIN
BOOTSTRAP_TEST_USERS_JSON=[{"login":"user01","password":"demo123","phone":"+70000000001","name":"Test User 01","plot_number":"101"},{"login":"user02","password":"demo123","phone":"+70000000002","name":"Test User 02","plot_number":"102"},{"login":"user03","password":"demo123","phone":"+70000000003","name":"Test User 03","plot_number":"103"},{"login":"user04","password":"demo123","phone":"+70000000004","name":"Test User 04","plot_number":"104"},{"login":"user05","password":"demo123","phone":"+70000000005","name":"Test User 05","plot_number":"105"}]

# -------------------------
# Login protection
# -------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# -------------------------
# Gate integration
# -------------------------
GATE_REAL_INTEGRATION_ENABLED=True
GATE_MDB_PATH=C:/GATE/Server/config.mdb
GATE_SYSTEMDB_PATH=C:/GATE/Server/Gate.mdw
GATE_MDB_UID=master
GATE_MDB_PWD=masterio0
GATE_ODBC_DRIVER=Microsoft Access Driver (*.mdb)
GATE_PYTHON_VERSION=-3.12-32
GATE_REAL_KEYTYPE_VEHICLE=3
GATE_REAL_KEYTYPE_PHONE=6
GATE_PHONE_WRITE_FORMAT=sample

# Current real action map and default points.
GATE_ACTION_MAP_JSON={"entry":19,"exit":20,"wicket_north":15,"wicket_lake":23,"wicket_admin":17,"wicket_forest":21}
DEFAULT_ACCESS_POINT_IDS_JSON=[15,17,19,20,21,23]
GSM_ACCESS_POINT_IDS_JSON=[5,6]
# Older fallback example:
# GATE_ACTION_MAP_JSON={"entry":1,"exit":2,"wicket_north":3,"wicket_lake":4,"wicket_admin":5,"wicket_forest":6}
# DEFAULT_ACCESS_POINT_IDS_JSON=[1,2,3,4,5,6]

# Fallback open mode for mock mode. Not used when real integration is enabled,
# but kept here so the file fully covers project settings.
GATE_OPEN_MODE=simulate
GATE_OPEN_SUCCESS_RATE=0.9

# -------------------------
# Courier/request policy
# -------------------------
COURIER_TTL_ONLY_ENABLED=True
COURIER_DEFAULT_HOURS=2
COURIER_MAX_HOURS=12

# -------------------------
# Cleanup worker
# -------------------------
CLEANUP_INTERVAL_SECONDS=60

# -------------------------
# Wiegand transport
# Current working opening path:
# Backend -> GateServ TCP 127.0.0.1:1917
# Payload hypothesis for the live setup: frame_hex + newline
# -------------------------
GATE_WIEGAND_TRANSPORT=gateserv_tcp
# Older server fallback example:
# GATE_WIEGAND_TRANSPORT=dry_run
GATE_WIEGAND_TIMEOUT_SECONDS=2.0
DRY_RUN=false

# GateServ TCP / 1917 live-test transport
GATE_GATESERV_HOST=127.0.0.1
GATE_GATESERV_PORT=1917
GATE_GATESERV_PAYLOAD_FORMAT=frame_hex
GATE_GATESERV_APPEND_NEWLINE=true
GATE_GATESERV_ENCODING=utf-8

# Fallback transport modes retained below for rollback:
# dry_run | http | tcp | gateserv_tcp

# HTTP Wiegand transport
GATE_WIEGAND_HTTP_URL=http://127.0.0.1:9000/wiegand
GATE_WIEGAND_HTTP_TOKEN=

# TCP Wiegand transport fallback
GATE_WIEGAND_TCP_HOST=192.168.0.65
# Older repo fallback example:
# GATE_WIEGAND_TCP_HOST=192.168.1.245
GATE_WIEGAND_TCP_PORT=5000
GATE_WIEGAND_TCP_PAYLOAD_FORMAT=json
GATE_WIEGAND_TCP_APPEND_NEWLINE=true
GATE_WIEGAND_TCP_ENCODING=utf-8

# -------------------------
# Frontend build/runtime behind Nginx
# Frontend should call the API through the same origin, not :8000 directly.
# -------------------------
EXPO_PUBLIC_USE_REAL_API=true
EXPO_PUBLIC_API_BASE_URL=/api
